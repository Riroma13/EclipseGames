{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
    "npm publish*": "deny",
      "pnpm publish*": "deny",
      "docker push *": "deny",
      "docker compose up -d*": "deny",
      "docker compose up *--detach*": "deny",
      "kubectl apply *": "deny",
      "helm upgrade *": "deny",
      "*": "ask"
    }
  }
}

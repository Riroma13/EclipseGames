{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "doom_loop": "deny",
    "bash": {
      "node --test scripts/sdd-lite.test.mjs": "allow",
      "pnpm test:sdd-lite": "allow",
      "opencode debug config": "allow",
      "opencode debug agent *": "allow",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "docker push *": "deny",
      "docker compose up -d*": "deny",
      "docker compose up *--detach*": "deny",
      "kubectl apply *": "deny",
      "helm upgrade *": "deny",
      "git push --force*": "deny",
      "git reset *": "deny",
      "git restore *": "deny",
      "git checkout -- *": "deny",
      "git clean *": "deny",
      "git branch -D *": "deny",
      "rm -r*": "deny",
      "sudo *": "deny",
      "mkfs *": "deny",
      "dd *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "docker system prune*": "deny",
      "docker volume rm *": "deny",
      "docker volume prune*": "deny",
      "netlify *": "deny",
      "npx netlify *": "deny",
      "pnpm deploy*": "deny",
      "npm deploy*": "deny",
      "*": "ask"
    }
  }
}
